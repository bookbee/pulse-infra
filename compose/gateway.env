# pulse-gateway configuration for the LOCAL stack.
#
# The gateway requires all 47 of these — `config.Load` collects every missing one
# and aborts startup. There are no defaults in the gateway, by design.
#
# Values here are local-dev fixtures. Nothing in this file is, or resembles, a
# real credential.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=dev
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=30s
SHUTDOWN_DRAIN_POLL_MS=500
FIBER_IDLE_TIMEOUT=30s
FIBER_APP_NAME=Pulse-Gateway

EVENT_MAX_PAYLOAD_BYTES=1048576
LOG_MAX_PAYLOAD_BYTES=524288
SIGNAL_MAX_PAYLOAD_BYTES=65536

# ── Auth ──────────────────────────────────────────────────────────────────────
# Mounted read-only from bootstrap/fixtures/api_keys.local.json.
# The gateway will NOT start without this file, despite its README implying auth
# is optional — the middleware is always installed and errors on an empty path.
AUTH_KEYS_FILE_PATH=/etc/pulse/auth_keys.json

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1s

# ── Queue backend ─────────────────────────────────────────────────────────────
# redis is the only backend the gateway implements. There is no Kafka producer
# in the gateway at this commit — see docs/divergences.md.
QUEUE_BACKEND=redis

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=pulse-local-not-a-secret
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_CONN_POOL_SIZE=20
REDIS_READ_TIMEOUT_MS=3000
REDIS_WRITE_TIMEOUT_MS=3000
REDIS_PING_TIMEOUT_MS=1000
REDIS_STREAM_APPROX_MAX_LEN=true

# Key names mirror the Kafka topic names — one vocabulary across both transports.
REDIS_STREAM_EVENTS=ingestion-events
REDIS_STREAM_SIGNALS=ingestion-signals
REDIS_LIST_LOGS=ingestion-logs

# Caps are deliberately LOW locally (10k, vs 100k in the gateway's own example).
# Both are lossy under lag: streams trim, and the log list's Lua script drops the
# write outright once the cap is hit. Low caps make that visible in development
# instead of in the dev environment.
REDIS_STREAM_MAX_LEN=10000
REDIS_LIST_LOGS_MAX_LEN=10000
# Key TTL, refreshed on every push — this purges an IDLE log list, it does NOT
# age out entries. Under continuous writes it never fires and
# REDIS_LIST_LOGS_MAX_LEN is the only bound. Redis lists have no age-based trim
# (pulse-gateway DEL-012). Kept at local scale rather than the 1800s the
# gateway's .env.example ships.
REDIS_LIST_LOGS_TTL_SECONDS=120

# Age-trims stream ENTRIES older than this via XTRIM MINID ~, so pulse-conflux
# sees a moving window regardless of write volume. Independent of
# REDIS_STREAM_MAX_LEN: Redis accepts MAXLEN or MINID per XADD, never both, so
# the gateway issues a separate XTRIM. 1800 = 30 minutes.
REDIS_STREAM_RETENTION_SECONDS=1800

# ── Per-API buffers ───────────────────────────────────────────────────────────
EVENT_PRIMARY_BUFFER_SIZE=10000
EVENT_OVERFLOW_BUFFER_SIZE=5000
LOG_PRIMARY_BUFFER_SIZE=10000
LOG_OVERFLOW_BUFFER_SIZE=5000
SIGNAL_PRIMARY_BUFFER_SIZE=10000
SIGNAL_OVERFLOW_BUFFER_SIZE=5000

# Utilization above which a full primary buffer is REFUSED (503 + Retry-After)
# rather than spilling into overflow, keeping the overflow tier as burst
# headroom. Must be below HEALTH_CHECK_MAX_BUFFER_UTILIZATION (0.9) so the
# gateway sheds load before it withdraws from the load balancer.
# This key was inert until pulse-gateway T-1.3; it now fails startup if out of (0,1].
SAFE_BUFFER_THRESHOLD=0.8

# ── Workers ───────────────────────────────────────────────────────────────────
WORKER_COUNT=4
WORKER_BATCH_SIZE=100
WORKER_FLUSH_MS=10
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_MS=100
WORKER_PUBLISH_TIMEOUT_MS=6000
WORKER_IDLE_BACKOFF_MS=5
WORKER_MAX_BACKOFF_MS=1000
WORKER_JITTER_MAX_MS=50
# Delay before a panicking worker is restarted, so a deterministic panic cannot
# become a hot loop. Before pulse-gateway T-1.4 a panicking worker was never
# replaced and the pool silently shrank toward zero.
WORKER_RESTART_BACKOFF_MS=1000

# ── Dead-letter queue ─────────────────────────────────────────────────────────
# Payloads the gateway could not deliver are stored here IN FULL so they can be
# inspected and replayed. Before pulse-gateway T-1.2 the DLQ logged an event id
# and discarded the bytes, so nothing was recoverable.
#
# This is a new Redis key — see docs/stack-contract.md. It is NOT telemetry:
# pulse-conflux must not consume it as a normal stream or list.
#
# If Redis itself is unreachable the sink degrades to logging, counted
# separately as dlq_events_total{reason="dlq_sink_failed"} — alert on that.
REDIS_LIST_DLQ=ingestion-dlq
# Local scale, matching the 10k caps above rather than the 500k the gateway's
# .env.example ships.
REDIS_LIST_DLQ_MAX_LEN=10000
# 7 days, so a failure over a weekend is still replayable on Monday.
REDIS_LIST_DLQ_TTL_SECONDS=604800

# ── Health checks ─────────────────────────────────────────────────────────────
HEALTH_CHECK_MAX_QUEUE_LATENCY_MS=500
HEALTH_CHECK_MAX_BUFFER_UTILIZATION=0.9
HEALTH_CHECK_PROBE_TIMEOUT_MS=2000

# ── Optional routes ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PATH=/metrics
SWAGGER_ENABLED=false
SWAGGER_PATH=/swagger/*
